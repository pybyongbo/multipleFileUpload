PORT=3004
HOST=127.0.0.1
NODE_ENV=development

# 其他配置（与前端访问地址保持一致：用 127.0.0.1 则前后端都写 127.0.0.1）
API_DOMAIN=http://127.0.0.1:3004

# 前端地址（CORS 需包含你实际打开的 origin）
CORS_ORIGIN=http://127.0.0.1:5173

# 微信开放平台「网站应用」扫码登录（https://open.weixin.qq.com/）
# 在微信开放平台创建网站应用后填写 AppID、AppSecret；授权回调域需包含回调 URL 的域名。
# WECHAT_REDIRECT_URI 必须与开放平台里配置的「授权回调域」一致，例如：
WECHAT_REDIRECT_URI=http://127.0.0.1:3004/wechat/callback
WECHAT_APP_ID=wx624f80cdafbea38d
WECHAT_APP_SECRET=a442232629a6b7f388d4f70ed1fe9291