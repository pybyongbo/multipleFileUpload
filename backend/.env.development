PORT=3004
HOST=localhost
NODE_ENV=development

API_DOMAIN=http://localhost:3004

# 与浏览器地址栏一致（前端用 localhost:5173 时填此项）
CORS_ORIGIN=http://localhost:5173

# 微信开放平台「网站应用」扫码登录（https://open.weixin.qq.com/）
# 在微信开放平台创建网站应用后填写 AppID、AppSecret；授权回调域需包含回调 URL 的域名。
# WECHAT_REDIRECT_URI 必须与开放平台里配置的「授权回调域」一致，例如：
WECHAT_REDIRECT_URI=http://localhost:3004/wechat/callback
WECHAT_APP_ID=wx624f80cdafbea38d
WECHAT_APP_SECRET=a442232629a6b7f388d4f70ed1fe9291