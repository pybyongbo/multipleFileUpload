PORT=3004
HOST=0.0.0.0

API_DOMAIN=https://fileuploadapi.901web.com

CORS_ORIGIN=https://fileupload.901web.com,https://www.fileupload.901web.com,http://fileupload.901web.com

# ---------- 微信登录（个人开发者：公众号网页授权）----------
# mp=公众号 snsapi_userinfo（个人订阅号可用）
# open=开放平台 snsapi_login（需企业认证 + 能力开通）
WECHAT_LOGIN_MODE=mp

# 公众号：mp.weixin.qq.com → 开发 → 基本配置
MP_WECHAT_APP_ID=wxd58d51461aa81418
MP_WECHAT_APP_SECRET=dc208ade59d2888962bef3e6b6ff2ee7

# 须与 mp.weixin.qq.com「网页授权域名」完全一致（仅主机名，不要写 fileuploadapi）
MP_WEB_AUTH_DOMAIN=fileupload.901web.com
WECHAT_REDIRECT_URI=https://fileupload.901web.com/wechat/callback

# 开放平台网站应用（企业账号再用，与 MP_ 不要混用）
# WECHAT_LOGIN_MODE=open
